@model intproje.Mvc.Models.Company

@{
    ViewData["Title"] = "Şirket Detayı";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4>@Model.Name</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Şirket Adı:</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Sektör:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">@Model.Sector</span>
                </dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary me-2">Düzenle</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Geri Dön</a>
            </div>
        </div>
    </div>
</div>

