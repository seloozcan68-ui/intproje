@model IEnumerable<intproje.Mvc.Models.JobPost>

@{
    ViewData["Title"] = "İş İlanları";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>İş İlanları</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni İlan Ekle
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title">@item.Title</h5>
                                @if (item.Company != null)
                                {
                                    <span class="badge bg-info">@item.Company.Name</span>
                                }
                            </div>
                            <p class="card-text text-muted">@(item.Description.Length > 150 ? item.Description.Substring(0, 150) + "..." : item.Description)</p>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detaylar</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Henüz iş ilanı bulunmamaktadır. İlk ilanı eklemek için <a asp-action="Create">buraya tıklayın</a>.
        </div>
    }
</div>

