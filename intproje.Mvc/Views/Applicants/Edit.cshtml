@model intproje.Mvc.Models.Applicant

@{
    ViewData["Title"] = "Başvuru Düzenle";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4>Başvuruyu Düzenle</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="control-label">Ad Soyad</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="CvSummary" class="control-label">CV Özeti</label>
                            <textarea asp-for="CvSummary" class="form-control" rows="8"></textarea>
                            <span asp-validation-for="CvSummary" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label asp-for="JobPostId" class="control-label">İlan</label>
                            <select asp-for="JobPostId" class="form-control">
                                @if (ViewBag.Jobs != null)
                                {
                                    @foreach (var job in (List<intproje.Mvc.Models.JobPost>)ViewBag.Jobs)
                                    {
                                        <option value="@job.Id" selected="@(job.Id == Model.JobPostId)">@job.Title</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="JobPostId" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">Güncelle</button>
                            <a asp-action="Index" class="btn btn-secondary">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

