@model intproje.Mvc.Models.Applicant

@{
    ViewData["Title"] = "Başvuru Detayı";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4>Başvuru Detayı</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Ad Soyad:</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">CV Özeti:</dt>
                <dd class="col-sm-9">
                    <div class="p-3 bg-light rounded">
                        @Model.CvSummary
                    </div>
                </dd>

                <dt class="col-sm-3">Başvurulan İlan:</dt>
                <dd class="col-sm-9">
                    @if (Model.JobPost != null)
                    {
                        <span class="badge bg-info fs-6">@Model.JobPost.Title</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </dd>
            </dl>

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary me-2">Düzenle</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Geri Dön</a>
            </div>
        </div>
    </div>
</div>

