@{
    ViewData["Title"] = "İş Portalı | Ana Sayfa";
}

<div class="container mt-5">
    <div class="p-5 mb-4 bg-primary text-white rounded-3 shadow text-center">
        <h1 class="display-4 fw-bold">Yeni İşin Seni Bekliyor</h1>
        <p class="fs-4">Şirketler ve adaylar arasındaki köprü.</p>
        <div class="d-flex justify-content-center mt-4">
            <input type="text" class="form-control w-50 me-2" placeholder="İş ilanı veya şirket ara...">
            <form asp-controller="Jobs" asp-action="Index" method="get" class="d-flex justify-content-center mt-4">
    <input type="text" name="searchString" class="form-control w-50 me-2" placeholder="İş ilanı veya şirket ara...">
    <button type="submit" class="btn btn-warning fw-bold">İlan Bul</button>
</form>
        </div>
    </div>

    <div class="row text-center mb-5">
        <div class="col-md-4">
            <div class="p-3 border rounded shadow-sm bg-white">
                <h3 class="text-primary">150+</h3>
                <p class="text-muted mb-0">Aktif Şirket</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border rounded shadow-sm bg-white">
                <h3 class="text-primary">500+</h3>
                <p class="text-muted mb-0">Güncel İlan</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border rounded shadow-sm bg-white">
                <h3 class="text-primary">1200+</h3>
                <p class="text-muted mb-0">Başvuran Aday</p>
            </div>
        </div>
    </div>

<h2 class="mb-4 border-bottom pb-2">Öne Çıkan İlanlar</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-success">Yeni</span>
                            <small class="text-muted font-weight-bold text-uppercase">İlan No: @item.Id</small>
                        </div>
                        <h5 class="card-title fw-bold text-dark">@item.Title</h5>
                        <p class="card-text text-secondary small">@item.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="text-muted"><i class="bi bi-geo-alt"></i> Aktif İlan</span>
                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-4">Detayları Gör</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
</div>
